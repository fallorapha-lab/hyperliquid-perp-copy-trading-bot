# Copy to .env and fill in. Never commit .env.

# Required for trading / account commands (0x-prefixed hex private key)
PRIVATE_KEY=

# Hyperliquid testnet (recommended for development)
HL_TESTNET=true

# Perp symbol (default scope for copy when COPY_ALL_COINS=false and COPY_SYMBOLS empty)
COIN=BTC

# --- Copy trading (`copy` / `copy status`) ---
# Leader wallet address to mirror (required for copy commands)
COPY_LEADER_ADDRESS=
# Scale leader signed size (1 = same size, 0.1 = 10% notional)
COPY_SIZE_RATIO=1
# true = sync all markets leader (or you) have open; false = use COIN or COPY_SYMBOLS only
COPY_ALL_COINS=false
# Comma-separated list, e.g. BTC,ETH (used when COPY_ALL_COINS=false; overrides COIN if set)
# COPY_SYMBOLS=
# Skip rebalance if |delta| * mid below this USD (exchange minimum ~$5 typical)
COPY_MIN_NOTIONAL_USD=5
# Optional: ignore tiny deltas in base units (0 = off)
# COPY_MIN_ABS_DELTA=0
# JSON Lines log for copy intents/orders
COPY_TRADING_LOG=true
COPY_LOG_FILE=logs/copy-trading.jsonl

# Poll interval for `run` and `copy` loops (milliseconds)
POLL_INTERVAL_MS=5000

# When true, the bot never sends signed exchange actions (orders still logged)
DRY_RUN=true

# Paper trading: simulated fills at live mids (see "paper" CLI commands)
PAPER_TRADING=false
PAPER_INITIAL_USD=100000
# PAPER_STATE_FILE=paper-state.json

# Paper trading logs (JSON Lines, one JSON object per line)
PAPER_LOG=true
PAPER_LOG_FILE=logs/paper-trading.jsonl
# Default line count for `paper logs` (no arg)
# PAPER_LOG_TAIL=200
# Set true to append a line on every `paper status`
PAPER_LOG_STATUS=false
# With `run` + PAPER_TRADING=true, append a snapshot every N ms (0 = off)
# PAPER_LOG_INTERVAL_MS=60000
